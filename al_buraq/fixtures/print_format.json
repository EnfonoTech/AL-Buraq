  "format_data": null,
  "html": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Accounts Receivable</title>\n    <style>\n        @page {\n            size: auto;\n            margin: 15px;\n        }\n        html, body {\n            margin: 0;\n        }\n        body {\n            font-family: Arial, sans-serif;\n            font-size: 8.5pt;\n            line-height: 1.2;\n        }\n\n        /* Outer wrapper table: thead/tfoot repeat natively on EVERY printed\n           page in wkhtmltopdf - this is the reliable way to get a repeating\n           header/footer with this PDF engine. Avoid position:fixed, which\n           wkhtmltopdf does not handle consistently across page breaks. */\n        .ar-wrapper {\n            width: 100%;\n            border-collapse: collapse;\n        }\n        .ar-wrapper > thead > tr > td,\n        .ar-wrapper > tbody > tr > td,\n        .ar-wrapper > tfoot > tr > td {\n            padding: 0;\n            border: none;\n        }\n\n        .header-table {\n            width: 100%;\n            border-collapse: collapse;\n        }\n        .hdr-company-name {\n            font-size: 11pt;\n            font-weight: bold;\n            text-align: right;\n        }\n        .company-addr {\n            font-size: 7.5pt;\n            line-height: 1.3;\n        }\n        .hdr-cell {\n            padding-bottom: 6px !important;\n        }\n\n        .print-footer {\n            width: 100%;\n            text-align: center;\n            font-size: 7.5pt;\n            border-top: 1px solid #000;\n            padding-top: 4px !important;\n        }\n\n        .title { text-align: center; font-size: 13pt; font-weight: bold; margin: 0 0 3px; }\n        .company-name { text-align: center; font-size: 10pt; font-weight: bold; margin-bottom: 3px; }\n        .period { text-align: center; font-size: 9pt; margin-bottom: 8px; color: #333; }\n\n        .to-box { padding: 4px 0; margin-bottom: 4px; border-bottom: 1px solid #ddd; }\n        .to-box .to-label { font-size: 8.5pt; color: #555; margin-bottom: 2px; }\n        .to-box .party-name { font-size: 10pt; font-weight: bold; color: #111; }\n        .to-box .party-meta { font-size: 8pt; color: #444; line-height: 1.5; margin-top: 2px; }\n\n        p { margin: 3px 0; font-size: 8.5pt; }\n\n        table { width: 100%; border-collapse: collapse; font-size: 7pt; margin-top: 6px; table-layout: fixed; }\n        th, td { border: 0.5px solid #000; text-align: center; line-height: 1.1; padding: 1.5px 3px; word-wrap: break-word; overflow-wrap: break-word; }\n        th { font-weight: bold; background-color: #2E86C1; color: #fff !important; }\n\n        .text-right { text-align: right; }\n        .text-left  { text-align: left; }\n        .text-center { text-align: center; }\n\n        .row-even td { background-color: #fafaf8; }\n        .row-odd  td { background-color: #f5f3ef; }\n        .total-row td { background-color: #3498DB; color: #fff; font-weight: bold; }\n\n        .aging-summary { margin-top: 12px; }\n        .aging-summary table { font-size: 8pt; }\n        .aging-summary th { background-color: #3498DB; color: #fff !important; }\n        .aging-label-row td { background-color: #e8e4dc; font-weight: bold; }\n\n        .footer-note { margin-top: 10px; font-size: 7.5pt; color: #555; text-align: center; }\n\n        tr, td, th { page-break-inside: avoid; }\n        thead { display: table-header-group; }\n    </style>\n</head>\n<body>\n\n<table class=\"ar-wrapper\">\n    <thead>\n        <tr><td class=\"hdr-cell\">\n            <table class=\"header-table\">\n                <tr>\n                    <td style=\"width: 30%; vertical-align: top;\">\n                        {% if company_logo %}<img src=\"{{ company_logo }}\" style=\"height: 65px;\">{% endif %}\n                    </td>\n                    <td style=\"width: 70%; text-align: right; vertical-align: top;\">\n                        <div class=\"hdr-company-name\">{{ company_display_name }}</div>\n                        {% for line in company_address_lines %}\n                        <div class=\"company-addr\">{{ line }}</div>\n                        {% endfor %}\n                    </td>\n                </tr>\n            </table>\n        </td></tr>\n    </thead>\n    <tfoot>\n        <tr><td>\n            <div class=\"print-footer\">\n                {{ company_display_name }}{% if company_tax_id %} | TRN {{ company_tax_id }}{% endif %}\n            </div>\n        </td></tr>\n    </tfoot>\n    <tbody>\n        <tr><td>\n\n<div class=\"title\">{{ report_title }}</div>\n\n<div class=\"company-name\">{{ filters.company or \"\" }}</div>\n\n<div class=\"period\">As of {{ as_of_date }}</div>\n\n{% if party_name %}\n<div class=\"to-box\">\n    <div class=\"to-label\">To</div>\n    <div class=\"party-name\">{{ party_name }}</div>\n    {% if party_address %}\n    <div style=\"font-size:8pt; color:#444; margin-top:2px; line-height:1.5;\">{{ party_address }}</div>\n    {% endif %}\n    <div class=\"party-meta\">\n        {% if filters.party_type %}<strong>Party Type:</strong> {{ filters.party_type }}{% endif %}\n        {% if party_tax_id %}&nbsp;|&nbsp;<strong>Tax ID:</strong> {{ party_tax_id }}{% endif %}\n    </div>\n</div>\n{% endif %}\n\n<p>\n    {% if filters.company %}<strong>Company:</strong> {{ filters.company }} &nbsp;{% endif %}\n</p>\n\n<table>\n    <thead>\n        <tr>\n            <th style=\"width:72px;\">Invoice Date</th>\n            <th style=\"width:45px;\">Type</th>\n            <th class=\"text-left\" style=\"width:110px;\">Invoice No.</th>\n            <th class=\"text-left\" style=\"width:100px;\">LPO No.</th>\n            <th class=\"text-right\" style=\"width:76px;\">Amount ({{ currency }})</th>\n            <th class=\"text-right\" style=\"width:72px;\">Adjusted ({{ currency }})</th>\n            <th class=\"text-right\" style=\"width:76px;\">Balance ({{ currency }})</th>\n            <th class=\"text-right\" style=\"width:82px;\">Cum.Bal ({{ currency }})</th>\n            <th style=\"width:50px;\">Aged.Days</th>\n        </tr>\n    </thead>\n    <tbody>\n        {% for row in rows %}\n        <tr class=\"{{ 'row-even' if loop.index0 % 2 == 0 else 'row-odd' }}\">\n            <td>{{ row.posting_date_display }}</td>\n            <td>{{ row.type_label }}</td>\n            <td class=\"text-left\">{{ row.voucher_no }}</td>\n            <td class=\"text-left\">{{ row.lpo or \"-\" }}</td>\n            <td class=\"text-right\">{{ row.amount_display }}</td>\n            <td class=\"text-right\">{{ row.adjusted_display }}</td>\n            <td class=\"text-right\">{{ row.balance_display }}</td>\n            <td class=\"text-right\"><strong>{{ row.cum_bal_display }}</strong></td>\n            <td>{{ row.age if row.age is not none else \"-\" }}</td>\n        </tr>\n        {% endfor %}\n\n        <tr class=\"total-row\">\n            <td></td>\n            <td class=\"text-left\" colspan=\"3\"><strong>Total</strong></td>\n            <td class=\"text-right\">{{ currency }}&nbsp;{{ totals.amount_display }}</td>\n            <td class=\"text-right\">{{ currency }}&nbsp;{{ totals.adjusted_display }}</td>\n            <td class=\"text-right\">{{ currency }}&nbsp;{{ totals.balance_display }}</td>\n            <td class=\"text-right\">{{ currency }}&nbsp;{{ totals.cum_bal_display }}</td>\n            <td></td>\n        </tr>\n    </tbody>\n</table>\n\n<div class=\"aging-summary\">\n    <div style=\"font-weight:bold; font-size:9pt; margin-bottom:4px;\">\n        Ageing Summary\n        {% if filters.ageing_based_on %}<span style=\"font-weight:normal; font-size:8pt; color:#555;\">(Based On: {{ filters.ageing_based_on }})</span>{% endif %}\n    </div>\n    <table>\n        <thead>\n            <tr>\n                <th>Less than 30 Days</th>\n                <th>31 to 60 Days</th>\n                <th>61 to 90 Days</th>\n                <th>91 to 180 Days</th>\n                <th>More than 180 Days</th>\n                <th>Total Overdue Amount</th>\n            </tr>\n        </thead>\n        <tbody>\n            <tr class=\"aging-label-row\">\n                <td class=\"text-right\">{{ currency }}&nbsp;{{ totals.range1_display }}</td>\n                <td class=\"text-right\">{{ currency }}&nbsp;{{ totals.range2_display }}</td>\n                <td class=\"text-right\">{{ currency }}&nbsp;{{ totals.range3_display }}</td>\n                <td class=\"text-right\">{{ currency }}&nbsp;{{ totals.range4_display }}</td>\n                <td class=\"text-right\">{{ currency }}&nbsp;{{ totals.range5_display }}</td>\n                <td class=\"text-right\"><strong>{{ currency }}&nbsp;{{ totals.overdue_display }}</strong></td>\n            </tr>\n        </tbody>\n    </table>\n</div>\n\n<div class=\"footer-note\">\n    Generated on {{ generated_on }}\n    {% if filters.company %}&nbsp;&middot;&nbsp; {{ filters.company }}{% endif %}\n</div>\n\n        </td></tr>\n    </tbody>\n</table>\n\n</body>\n</html>\n",
